NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./var/research-tasks.sqlite
# Exact browser origin for login and CSRF checks. Use the actual HTTPS origin in production.
APP_ORIGIN=http://127.0.0.1:5173
# Accounts are created with `corepack pnpm account:create <username>`; no plaintext password is stored here.
# DeepSeek intent parsing/read queries. The key stays on the server (environment or local .env).
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Optional Web Push. Generate once with `corepack pnpm push:keys`; keep the private key secret.
# A stable key pair and a real operator contact (mailto: or HTTPS URL) are required.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
# Optional redacted HTTP route/timing logs. Never logs request bodies or credentials.
REQUEST_LOGS=false
# Set to the immutable source revision for release images and backup metadata.
BUILD_REVISION=
