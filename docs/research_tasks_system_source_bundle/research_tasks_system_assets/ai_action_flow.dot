digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.45", fontname="Noto Sans CJK SC", label="AI 操作生命周期：先提案、再确认、后执行", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#CBD5E1", fontname="Noto Sans CJK SC", fontsize=10, margin="0.13,0.09"];
  edge [color="#64748B", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=9];
  input [label="用户自然语言输入", fillcolor="#EFF6FF", color="#93C5FD"];
  context [label="读取最小上下文\n用户时区 / 任务 / 日历"];
  llm [label="LLM 意图解析与工具调用\n只允许白名单工具", fillcolor="#FDF2F8", color="#F9A8D4"];
  validate [label="Schema + 业务校验\n权限 / 时间 / 版本 / 冲突"];
  proposal [label="保存 Action Proposal\n结构化变更预览", fillcolor="#FFF7ED", color="#FDBA74"];
  user [shape=diamond, label="用户确认？", fillcolor="#FEFCE8", color="#FDE047"];
  execute [label="事务执行\n幂等键 / 乐观锁 / 审计", fillcolor="#ECFDF5", color="#86EFAC"];
  result [label="返回执行结果\n刷新界面 / 可撤销（适用时）"];
  cancel [label="拒绝 / 过期 / 重新生成\n不产生业务变更"];
  input -> context -> llm -> validate -> proposal -> user;
  user -> execute [label="是"];
  user -> cancel [label="否"];
  execute -> result;
}
