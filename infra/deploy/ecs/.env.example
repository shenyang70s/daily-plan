NODE_ENV=production
HOST=127.0.0.1
PORT=3000
NODE_BINARY=/srv/research-tasks/runtime/node/bin/node
APP_ORIGIN=https://plan.datafab.cn
DATABASE_PATH=/var/lib/research-tasks/research-tasks.sqlite
BACKUP_DIRECTORY=/var/backups/research-tasks
BUILD_REVISION=replace-with-source-commit
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Device push is optional. Application notifications work without these values.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
REQUEST_LOGS=false
