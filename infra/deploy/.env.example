# Copy to .env.production on the deployment host and keep it private.
APP_ORIGIN=https://research.example.com
BUILD_REVISION=replace-with-source-commit
DATA_DIRECTORY=/srv/research-tasks/data
# Use a distinct durable volume/location; do not place under DATA_DIRECTORY.
BACKUP_DIRECTORY=/srv/research-tasks-backups
DATABASE_PATH=/data/research-tasks.sqlite
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
REQUEST_LOGS=false
